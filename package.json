{
  "name": "unicode-utils-monorepo",
  "version": "0.12.0-beta.27",
  "private": true,
  "homepage": "https://github.com/luxass/unicode-utils#readme",
  "bugs": "https://github.com/luxass/unicode-utils/issues",
  "license": "MIT",
  "author": {
    "name": "Lucas Nørgård",
    "email": "lucasnrgaard@gmail.com",
    "url": "https://luxass.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luxass/unicode-utils.git"
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build --filter \"./packages/*\" --concurrency=15",
    "clean": "turbo run clean && git clean -xdf node_modules",
    "dev": "turbo watch dev --filter \"./packages/*\"",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "generate:header-files": "tsx scripts/generate-header-tests.ts",
    "fetch-ucd-files": "node scripts/fetch-ucd-files.ts"
  },
  "devDependencies": {
    "@types/node": "catalog:types",
    "oxfmt": "catalog:dev",
    "oxlint": "catalog:dev",
    "oxlint-tsgolint": "catalog:dev",
    "tsx": "catalog:dev",
    "turbo": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:testing"
  },
  "packageManager": "pnpm@11.5.3"
}
