{
  "name": "@unicode-utils/core",
  "version": "0.12.0-beta.19",
  "description": "Utilities for working with Unicode",
  "type": "module",
  "author": {
    "name": "Lucas Nørgård",
    "email": "lucasnrgaard@gmail.com",
    "url": "https://luxass.dev"
  },
  "packageManager": "pnpm@10.28.2",
  "license": "MIT",
  "homepage": "https://github.com/luxass/unicode-utils#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luxass/unicode-utils.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/luxass/unicode-utils/issues",
  "keywords": [
    "unicode",
    "utils"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./constants": "./dist/constants.mjs",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown --tsconfig=./tsconfig.build.json",
    "dev": "tsdown --watch",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@luxass/utils": "catalog:build",
    "@unicode-utils/metadata": "workspace:*",
    "@unicode-utils/parser": "workspace:*",
    "defu": "catalog:build"
  },
  "devDependencies": {
    "@luxass/eslint-config": "catalog:linting",
    "@types/node": "catalog:types",
    "@unicode-utils-tooling/tsconfig": "workspace:*",
    "@unicode-utils-tooling/tsdown-config": "workspace:*",
    "eslint": "catalog:linting",
    "eslint-plugin-format": "catalog:linting",
    "msw": "catalog:testing",
    "publint": "catalog:dev",
    "tsdown": "catalog:dev",
    "tsx": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest-package-exports": "catalog:testing"
  }
}
