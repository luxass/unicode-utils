{
  "name": "@unicode-utils/parser",
  "version": "0.12.0-beta.27",
  "description": "Unicode data file parser with AST support",
  "keywords": [
    "ast",
    "datafile",
    "parser",
    "unicode"
  ],
  "homepage": "https://github.com/luxass/unicode-utils#readme",
  "bugs": "https://github.com/luxass/unicode-utils/issues",
  "license": "MIT",
  "author": {
    "name": "Lucas Nørgård",
    "email": "lucasnrgaard@gmail.com",
    "url": "https://luxass.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luxass/unicode-utils.git",
    "directory": "packages/parser"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./line-helpers": "./dist/line-helpers.mjs",
    "./models/data-file": "./dist/models/data-file.mjs",
    "./models/raw-data-file": "./dist/models/raw-data-file.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown --tsconfig=./tsconfig.build.json",
    "dev": "tsdown --watch",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@luxass/utils": "catalog:build"
  },
  "devDependencies": {
    "@types/node": "catalog:types",
    "@unicode-utils-tooling/tsconfig": "workspace:*",
    "@unicode-utils-tooling/tsdown-config": "workspace:*",
    "msw": "catalog:testing",
    "publint": "catalog:dev",
    "tsdown": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "packageManager": "pnpm@10.33.0"
}
