{
  "name": "@unicode-utils/api",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "build:openapi": "tsx ./scripts/build-openapi.ts",
    "deploy": "wrangler deploy",
    "test": "pnpm vitest --run",
    "lint": "eslint .",
    "lint:openapi": "pnpm run build:openapi && spectral lint ./node_modules/.openapi/openapi.json",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "typecheck": "pnpm run cf-typegen && tsc --noEmit"
  },
  "dependencies": {
    "@hono/zod-openapi": "catalog:build",
    "@luxass/unicode-utils": "workspace:*",
    "@scalar/hono-api-reference": "catalog:build",
    "hono": "catalog:build",
    "picomatch": "catalog:build",
    "zod": "catalog:build"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "catalog:testing",
    "@luxass/eslint-config": "catalog:linting",
    "@luxass/spectral-ruleset": "catalog:linting",
    "@stoplight/spectral-cli": "catalog:linting",
    "@types/picomatch": "catalog:types",
    "eslint": "catalog:linting",
    "eslint-plugin-format": "catalog:linting",
    "tsx": "catalog:dev",
    "typescript": "catalog:dev",
    "vite-tsconfig-paths": "catalog:dev",
    "vitest": "catalog:testing",
    "wrangler": "catalog:dev"
  }
}
